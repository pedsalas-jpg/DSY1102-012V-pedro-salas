<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TableColumn?>

<VBox xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.example.nuevoproyecto.HelloController"
      spacing="14"
      style="-fx-padding: 20;">

  <Label text="Cápsula del Tiempo" style="-fx-font-size: 18px; -fx-font-weight: bold;" />

  <TableView fx:id="tablaMensajes" VBox.vgrow="ALWAYS">
    <columns>
      <TableColumn fx:id="colAutor" text="Autor" prefWidth="150" />
      <TableColumn fx:id="colTexto" text="Mensaje" prefWidth="250" />
      <TableColumn fx:id="colPlazo" text="Leer dentro de" prefWidth="150" />
    </columns>
    <columnResizePolicy>
      <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
    </columnResizePolicy>
  </TableView>

</VBox>
