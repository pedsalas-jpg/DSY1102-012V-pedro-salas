<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox spacing="15.0" xmlns="http://javafx.com" xmlns:fx="http://javafx.com"
      fx:controller="org.example.gestorclientesfx.controller.ClienteController">
  <padding>
    <Insets bottom="20.0" left="20.0" right="20.0" top="20.0"/>
  </padding>

  <Label text="Gestión de Clientes" style="-fx-font-size: 18px; -fx-font-weight: bold;"/>

  <GridPane hgap="10.0" vgap="10.0">
    <Label text="ID:" GridPane.columnIndex="0" GridPane.rowIndex="0"/>
    <TextField fx:id="txtId" editable="false" promptText="Automático" GridPane.columnIndex="1" GridPane.rowIndex="0"/>

    <Label text="Nombre:" GridPane.columnIndex="0" GridPane.rowIndex="1"/>
    <TextField fx:id="txtNombre" promptText="Ej. Juan Soto" GridPane.columnIndex="1" GridPane.rowIndex="1"/>

    <Label text="Correo:" GridPane.columnIndex="2" GridPane.rowIndex="0"/>
    <TextField fx:id="txtCorreo" promptText="correo@ejemplo.com" GridPane.columnIndex="3" GridPane.rowIndex="0"/>

    <Label text="Ciudad:" GridPane.columnIndex="2" GridPane.rowIndex="1"/>
    <TextField fx:id="txtCiudad" promptText="Ej. Santiago" GridPane.columnIndex="3" GridPane.rowIndex="1"/>
  </GridPane>

  <HBox spacing="10.0">
    <Button text="Guardar" onAction="#guardarCliente"/>
    <Button text="Actualizar" onAction="#actualizarCliente"/>
    <Button text="Eliminar" onAction="#eliminarCliente"/>
  </HBox>

  <TableView fx:id="tablaClientes" onMouseClicked="#seleccionarCliente" VBox.vgrow="ALWAYS">
    <columns>
      <TableColumn fx:id="colId" text="ID" prefWidth="50.0"/>
      <TableColumn fx:id="colNombre" text="Nombre" prefWidth="160.0"/>
      <TableColumn fx:id="colCorreo" text="Correo" prefWidth="180.0"/>
      <TableColumn fx:id="colCiudad" text="Ciudad" prefWidth="130.0"/>
    </columns>
  </TableView>
</VBox>

